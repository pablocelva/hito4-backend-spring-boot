meta {
  name: 02 - Crear evento
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: none
}

body:json {
  {
    "cityId": 1,
    "name": "Concierto de Prueba",
    "venue": "Arena Brena",
    "capacity": 500
  }
}

script:post-response {
  test("Crear evento responde 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Consolida registro con tickets disponibles", function() {
    expect(res.getBody().availableTickets).to.equal(500);
  });

  test("Ciudad asignada correctamente", function() {
    expect(res.getBody().cityId).to.equal(1);
  });

  bru.setVar("createdEventId", res.getBody().id);
}
