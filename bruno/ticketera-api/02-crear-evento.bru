meta {
  name: 02 - Crear evento
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: none
}

body:json {
  {
    "name": "Concierto de Prueba",
    "venue": "Arena Breña",
    "capacity": 200
  }
}

script:post-response {
  test("Crear evento responde 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Consolida registro con tickets disponibles", function() {
    expect(res.getBody().availableTickets).to.equal(200);
  });
}