meta {
  name: 03 - Comprar entradas
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

body:json {
  {
    "eventId": {{createdEventId}},
    "quantity": 2,
    "customerName": "Juan Perez",
    "customerEmail": "customer@email.com"
  }
}

script:post-response {
  test("Compra exitosa responde 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Retorna evento y cantidad comprada", function() {
    expect(res.getBody().eventId).to.exist;
    expect(res.getBody().ticketsPurchased).to.equal(2);
  });

  test("Descuenta del inventario", function() {
    expect(res.getBody().remainingTickets).to.equal(498);
  });
}
