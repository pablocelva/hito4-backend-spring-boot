meta {
  name: 06 - Compra invalida
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

body:json {
  {
    "eventId": 1,
    "quantity": 0,
    "customerName": "Test User",
    "customerEmail": "invalid-email"
  }
}

script:post-response {
  test("Datos invalidos responde 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("JSON de error unificado", function() {
    expect(res.getBody().code).to.equal(400);
    expect(res.getBody().timestamp).to.exist;
  });
}
